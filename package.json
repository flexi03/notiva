{
  "name": "notiva",
  "version": "0.2.1",
  "private": true,
  "description": "Notiva – freie, lokale Notion-Alternative auf Markdown-Basis: Seiten, Datenbanken, Kacheln, Vorlagen",
  "author": "flexi03",
  "license": "MIT",
  "homepage": "https://github.com/flexi03/notiva#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flexi03/notiva.git"
  },
  "bugs": {
    "url": "https://github.com/flexi03/notiva/issues"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "bin": {
    "notiva-mcp": "dist-mcp/notiva-mcp.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs && npm run build && npm run electron:build && node scripts/screenshots-desktop.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "electron:build": "node scripts/build-electron.mjs",
    "mcp:build": "node scripts/build-mcp.mjs",
    "electron": "npm run build && npm run electron:build && npm run mcp:build && electron .",
    "dist:mac": "npm run build && npm run electron:build && npm run mcp:build && electron-builder --mac --publish never",
    "dist:win": "npm run build && npm run electron:build && npm run mcp:build && electron-builder --win --publish never",
    "dist:linux": "npm run build && npm run electron:build && npm run mcp:build && electron-builder --linux --publish never",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.56.0",
    "markdown-it": "^15.0.2",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "io.github.flexi03.notiva",
    "productName": "Notiva",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.icns",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Notiva nimmt im Vorlesungsmodus auf, um ein Transkript zu erstellen."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "extraResources": [
      {
        "from": "dist-mcp",
        "to": "mcp",
        "filter": [
          "*.mjs"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "flexi03",
        "repo": "notiva",
        "releaseType": "release"
      }
    ]
  }
}
